{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Docs site, static assets only. Build first: npm run build (npm run deploy does both).
  "name": "sheet-i18n-docs",
  "compatibility_date": "2026-05-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "sheet-i18n.momik.dev", "custom_domain": true }]
}
